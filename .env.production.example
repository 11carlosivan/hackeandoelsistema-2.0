# Dominio final. Debe apuntar por DNS al VPS antes de levantar Caddy.
APP_DOMAIN=subdominio.cliente.com
ACME_EMAIL=admin@cliente.com
FRONTEND_PORT=3000
BACKEND_PORT=4000
NEXT_PUBLIC_INDEXING_ENABLED=true

# MySQL interno de Docker.
MYSQL_DATABASE=hackeandoelsistema
MYSQL_USER=hackeando
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Auth/CMS. Generar con: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Seguridad y limites.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
SECURITY_CSP_REPORT_ONLY=false
MEDIA_MAX_FILE_SIZE_BYTES=8388608
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=/media/uploads
MEDIA_PUBLIC_BASE_PATH=/uploads/cms

# Media en hosting PHP externo opcional. Para Banahost usar remote_php y el mismo secreto en media-config.php.
MEDIA_REMOTE_UPLOAD_URL=
MEDIA_REMOTE_PUBLIC_BASE_URL=
MEDIA_REMOTE_SECRET=
MEDIA_REMOTE_TIMEOUT_MS=15000

# Reescritura de imagenes heredadas de WordPress si se sirven desde otro host.
LEGACY_MEDIA_BASE_URL=

# Datos publicos: clima y tasa USD/DOP. Por defecto usa Open-Meteo y BCRD.
WEATHER_API_URL=
EXCHANGE_RATE_SOURCE_URL=
PUBLIC_STATS_CACHE_SECONDS=900
PUBLIC_STATS_TIMEOUT_MS=5000

# Seed inicial opcional. Borrar o rotar despues del primer acceso.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrador HES
ADMIN_PASSWORD=replace-with-temporary-strong-admin-password

# Analiticas opcionales. Si no se configuran, el CMS no muestra numeros falsos en produccion.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
