{
  "expo": {
    "name": "Hackeando El Sistema",
    "slug": "hackeando-el-sistema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hesapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.hackeandoelsistema.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Hackeando El Sistema necesita acceso a tu galería para seleccionar y actualizar tu foto de perfil.",
        "NSCameraUsageDescription": "Hackeando El Sistema necesita acceso a la cámara para tomar tu foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.hackeandoelsistema.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://hackeandoelsistema.net"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "hesdevs-team",
    "extra": {
      "eas": {
        "projectId": "06876c67-366e-40ba-8d8d-c2fa5d9a3eea"
      }
    }
  }
}
