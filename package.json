  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:api": "node api/server.js",
    "build": "next build",
    "lint": "oxlint app components lib test api scripts",
    "test": "vitest run",
    "db:format": "prisma format --schema=prisma/schema.prisma",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "wp:inspect": "node scripts/wordpress/inspect-dump.mjs",
    "wp:inspect:local": "node scripts/wordpress/inspect-dump.mjs --dump %TEMP%/hes-wp-db/qscbkfcv_wp999.sql",
    "wp:import:dry-run": "node scripts/wordpress/import-dry-run.mjs",
    "wp:import:dry-run:local": "node scripts/wordpress/import-dry-run.mjs --dump %TEMP%/hes-wp-db/qscbkfcv_wp999.sql",
    "wp:import:core": "node scripts/wordpress/import-core.mjs",
    "wp:import:core:local": "node scripts/wordpress/import-core.mjs --dump %TEMP%/hes-wp-db/qscbkfcv_wp999.sql",
    "seo:sitemap:inventory": "node scripts/seo/sitemap-inventory.mjs",
    "seo:sitemap:inventory:live": "node scripts/seo/sitemap-inventory.mjs --sitemap https://hackeandoelsistema.net/sitemap.xml",
    "qa:routes:smoke": "node scripts/qa/public-route-smoke.mjs",
    "auth:seed-admin": "node scripts/auth/seed-admin.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
