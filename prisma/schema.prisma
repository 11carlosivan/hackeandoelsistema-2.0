}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  planId          String? @map("plan_id") @db.Uuid
  itemName        String  @map("item_name") @db.VarChar(180)
  quantity        Int
  unitPriceAmount Int     @map("unit_price_amount")
  totalAmount     Int     @map("total_amount")

  order Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan  PublicationPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([planId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          String?       @db.VarChar(80)
  providerReference String?       @map("provider_reference") @db.VarChar(180)
  amount            Int
  currency          String        @default("DOP") @db.VarChar(10)
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?       @map("payment_method") @db.VarChar(80)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([provider, providerReference])
  @@index([status, createdAt])
  @@map("payments")
}

model UserPublicationCredit {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  planId       String       @map("plan_id") @db.Uuid
  orderId      String?      @map("order_id") @db.Uuid
